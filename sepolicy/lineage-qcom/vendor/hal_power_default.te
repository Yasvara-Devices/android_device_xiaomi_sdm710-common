# To do powerhint on nodes defined in powerhint.json
# NOTE: rw_dir_file() does not exist in InfinityX policy (only r_dir_file).
# Expanded manually. Narrowed vs upstream: dir is read-only (nodes are
# kernel-created, HALs only write file contents), files stay read-write.
# This also satisfies the no-dir-write-on-sysfs neverallow.
allow hal_power_default proc_sched:dir r_dir_perms;
allow hal_power_default proc_sched:{ file lnk_file } rw_file_perms;
allow hal_power_default sysfs_devfreq:dir r_dir_perms;
allow hal_power_default sysfs_devfreq:{ file lnk_file } rw_file_perms;
allow hal_power_default sysfs_graphics:dir r_dir_perms;
allow hal_power_default sysfs_graphics:{ file lnk_file } rw_file_perms;
allow hal_power_default sysfs_kgsl:dir r_dir_perms;
allow hal_power_default sysfs_kgsl:{ file lnk_file } rw_file_perms;
allow hal_power_default sysfs_scsi_host:dir r_dir_perms;
allow hal_power_default sysfs_scsi_host:{ file lnk_file } rw_file_perms;
